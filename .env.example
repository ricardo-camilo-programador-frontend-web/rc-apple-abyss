# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Adsterra — one discreet ad on the apple varieties guide.
# Leave keys empty to render nothing. Set the same variables in Netlify
# (Site configuration → Environment variables) and redeploy.
# Native Banner: Adsterra panel → Websites → your site → Get Code.
# NEXT_PUBLIC_ADSTERRA_NATIVE_HOST is the script host from that snippet
# (shape: plXXXX.effectivegatecpm.com). Do not put a publisher id here.
# Display banner key is optional. Its host defaults to www.highperformanceformat.com.
# NEXT_PUBLIC_ADSTERRA_ENABLED=false forces the slot off. Empty = on only when a key exists.
# NEXT_PUBLIC_SITE_URL overrides the canonical origin used to skip preview deploys.
NEXT_PUBLIC_ADSTERRA_NATIVE_KEY=""
NEXT_PUBLIC_ADSTERRA_NATIVE_HOST=""
NEXT_PUBLIC_ADSTERRA_BANNER_KEY=""
NEXT_PUBLIC_ADSTERRA_BANNER_HOST=""
NEXT_PUBLIC_ADSTERRA_ENABLED=""
NEXT_PUBLIC_SITE_URL=""

# Analytics (defaults shown; empty/placeholder values fall back to these defaults)
# Microsoft Clarity project id
NEXT_PUBLIC_CLARITY_ID="vtlognmjgs"
# Google Analytics 4 measurement id (legacy fallback name: NEXT_PUBLIC_GA_MEASUREMENT_ID)
NEXT_PUBLIC_GA4_ID="G-V44M6KV02M"
# Optional Google Tag Manager: only loads when GTM_ENABLED='true' and GTM_ID is set.
# If GTM_GA4_ID equals GA4_ID, the direct gtag snippet is skipped (no double counting).
NEXT_PUBLIC_GTM_ENABLED="false"
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_GTM_GA4_ID=""
# counter.dev (legacy fallback name: NEXT_PUBLIC_COUNTER_DEV_ID)
NEXT_PUBLIC_COUNTER_ID="f30df6f3-776d-4154-959d-0210ac8a8325"
NEXT_PUBLIC_COUNTER_UTCOFFSET="-3"
# Kill switch for all analytics scripts
NEXT_PUBLIC_ANALYTICS_ENABLED="true"
