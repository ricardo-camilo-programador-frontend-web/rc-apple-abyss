#!/usr/bin/env sh

# ─── Pre-commit hook (POSIX sh) ───
# Runs: merge conflict check, lint-staged (Biome), optional Gitleaks

set -e

# 1. Check for merge conflict markers in staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null)
if [ -n "$STAGED_FILES" ]; then
  CONFLICTS=""
  for FILE in $STAGED_FILES; do
    # Skip this hook itself to avoid false positive
    case "$FILE" in .husky/*) continue ;; esac
    if grep -qE '^<<<<<<< ' "$FILE" 2>/dev/null; then
      CONFLICTS="${CONFLICTS}${FILE}\n"
    fi
  done
  if [ -n "$CONFLICTS" ]; then
    echo "❌ Merge conflict markers found in staged files:"
    printf "%b" "$CONFLICTS"
    exit 1
  fi
fi

# 2. Run lint-staged (Biome on staged files)
npx lint-staged

# 3. Optional Gitleaks quick scan (graceful skip if not installed)
if command -v gitleaks >/dev/null 2>&1; then
  if [ -f .gitleaks.toml ]; then
    gitleaks protect --staged --redact --config .gitleaks.toml 2>/dev/null || {
      echo "⚠️ Gitleaks found potential secrets in staged files."
      exit 1
    }
  fi
fi
