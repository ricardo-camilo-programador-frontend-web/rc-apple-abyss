{
  "$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedVariables": {
          "level": "error",
          "fix": "none",
          "options": {
            "ignoreRestSiblings": true
          }
        }
      },
      "style": {
        "useConsistentArrayType": {
          "level": "error",
          "options": {
            "syntax": "generic"
          }
        },
        "useImportType": "warn"
      },
      "suspicious": {
        "noConsole": {
          "level": "warn",
          "options": {
            "allow": ["warn", "error"]
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "files": {
    "includes": ["**"],
    "ignoreUnknown": true,
    "experimentalScannerIgnores": [
      ".next",
      "node_modules",
      "coverage",
      "dist",
      "*.d.ts",
      "tsconfig.tsbuildinfo",
      ".github",
      "eslint-patch-bypass.cjs",
      "eslint-patch-stub.cjs",
      "lint.cjs",
      "pnpm-lock.yaml"
    ]
  }
}
