<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 180 180">
  <defs>
    <radialGradient id="appleGradient" cx="35%" cy="35%">
      <stop offset="0%" style="stop-color:#ff6b6b"/>
      <stop offset="100%" style="stop-color:#c0392b"/>
    </radialGradient>
  </defs>
  
  <rect width="180" height="180" rx="45" fill="white"/>
  
  <g transform="translate(90 90)">
    <!-- Apple Body -->
    <path d="M 0 -40
             C -25 -40, -40 -25, -40 0
             C -40 25, -25 40, 0 40
             C 25 40, 40 25, 40 0
             C 40 -25, 25 -40, 0 -40" 
          fill="url(#appleGradient)"/>
    
    <!-- Apple Indentation -->
    <path d="M -10 -12 C 10 -12, 12 -6, 0 -20 C -12 -6, -10 -12" 
          fill="#a02020" opacity="0.3"/>
    
    <!-- Apple Leaf -->
    <path d="M 0 -40 C 5 -45, 10 -45, 10 -40 C 10 -35, 5 -40, 0 -40" 
          fill="#4ade80"/>
    
    <!-- Stem -->
    <rect x="-3" y="-46" width="6" height="8" rx="3" 
             fill="#8b4513"/>
    
    <!-- Highlight -->
    <ellipse cx="-12" cy="-8" rx="15" ry="22" 
               fill="white" opacity="0.15" transform="rotate(-20)"/>
  </g>
</svg>