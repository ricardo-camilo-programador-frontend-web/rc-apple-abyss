<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100">
  <defs>
    <radialGradient id="appleGradient" cx="35%" cy="35%">
      <stop offset="0%" style="stop-color:#ff6b6b"/>
      <stop offset="100%" style="stop-color:#c0392b"/>
    </radialGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="2" dy="4" stdDeviation="3" flood-opacity="0.3"/>
    </filter>
  </defs>
  
  <!-- Apple Shape -->
  <g filter="url(#shadow)">
    <!-- Apple Body -->
    <path d="M 50 10 
             C 35 10, 20 25, 20 45
             C 20 70, 30 90, 50 90
             C 70 90, 80 70, 80 45
             C 80 25, 65 10, 50 10" 
          fill="url(#appleGradient)"/>
    
    <!-- Apple Indentation -->
    <path d="M 45 15 C 55 15, 60 25, 50 40 C 40 25, 45 15" 
          fill="#a02020" opacity="0.3"/>
    
    <!-- Apple Leaf -->
    <path d="M 50 10 C 55 5, 65 5, 65 15 C 65 20, 55 15, 50 10" 
          fill="#4ade80"/>
    <path d="M 50 10 C 53 8, 58 8, 58 15" 
          fill="#166534" opacity="0.5"/>
    
    <!-- Stem -->
    <rect x="48" y="2" width="4" height="8" rx="2" 
             fill="#8b4513"/>
    
    <!-- Highlight -->
    <ellipse cx="35" cy="35" rx="8" ry="12" 
               fill="white" opacity="0.2" transform="rotate(-20 35 35)"/>
  </g>
</svg>